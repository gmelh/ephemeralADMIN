# ephemeralADMIN — environment configuration
#
# Copy this file to .env and fill in what you need. Every value here is
# optional — config.php's own defaults apply to anything left unset or
# left as an empty value, so a completely empty .env (or no .env at all)
# is a valid, working configuration.
#
# This file is only read on bare-metal / non-Docker installs. Under
# Docker Compose, these are set directly in docker-compose.yml's
# environment: block instead (reading from ephemeralREST's own .env,
# using PORTAL_-prefixed variable names there to avoid colliding with the
# API's own identically-named settings) — this file has no effect in that
# setup and doesn't need to exist.
#
# A real environment variable (however it's set — shell, Apache, PHP-FPM
# pool config, Docker) always takes priority over this file if both are
# present; this file only fills in whatever isn't already set.


# ── API connection ────────────────────────────────────────────────────
# Default: http://localhost:5000

# Address the portal actually connects to. On a bare-metal install this
# is normally the same as API_PUBLIC_URL below; only differs under Docker
# Compose, where it's the internal container network address.
API_BASE=http://localhost:5000

# What gets *displayed* to an admin (Dashboard "Endpoint" field, API
# Tester header) — as distinct from API_BASE above, which is what the
# portal actually calls under the hood. Falls back to API_BASE if unset,
# so you only need this when the two genuinely differ (Docker Compose).
API_PUBLIC_URL=


# ── Branding ───────────────────────────────────────────────────────────

# Shown in the title, header, and sidebar — including pre-login pages
# (login, 2FA, etc.). Default: ephemeralREST
SITE_NAME=

# Shown in the sidebar footer. Purely local to the portal — the API has
# no concept of a "portal version". Default: 1.0
SITE_VERSION=


# ── Session & security ──────────────────────────────────────────────────

# How long, in seconds, before an inactive session is expired.
# Default: 1800 (30 minutes)
SESSION_TIMEOUT=

# Whether the portal's Keys page offers granting/revoking admin status at
# all. This is a UI-affordance flag only — the real enforcement is
# ephemeralREST's own ALLOW_ADMIN_PROMOTION (see that project's .env),
# checked server-side regardless of what the portal shows. Set both the
# same way; the portal's read-only Settings page will show a warning if
# they disagree. Default: true
ALLOW_ADMIN_PROMOTION=


# ── Navigation ───────────────────────────────────────────────────────────

# Where to send someone after they sign out. A relative path (e.g.
# /landing.php) stays on this server; a full URL redirects elsewhere.
# Default: /login.php
LOGOUT_REDIRECT_URL=